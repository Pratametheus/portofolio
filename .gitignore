# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers
.superpowers/

# agent-local tooling & transient run state
.claude/
.codex/
.agents/
figma-portfolio-state.json
design-qa.md

# transient QA artifacts
/qa-*.png
/_to_delete/

# Figma-revision working area (raw exports, Canva rasters, before/after shots).
# Final optimized assets live in public/ and are committed there.
/assets/

# Cloudflare build output, generated types, local state and secrets
/.open-next/
/.wrangler/
/cloudflare-env.d.ts
.dev.vars*
